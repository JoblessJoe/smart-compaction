{
  "name": "smart-compaction",
  "version": "0.3.14",
  "description": "dsh plugin: a compact_now tool letting the model trigger compaction itself at a safe point, plus a context_status tool so it can check real token usage against its context window, instead of only the automatic token-threshold trigger.",
  "icon": "./icon.svg",
  "homepage": "https://joblessjoe.com/smart-compaction",
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Johannes Tebbert <info@joblessjoe.com> (https://joblessjoe.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoblessJoe/smart-compaction.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "compaction",
    "context-management",
    "上下文压缩",
    "dsh插件"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Smart Compaction",
    "summary": "Gives the model a compact_now tool so it can trigger compaction itself at a safe point, plus a context_status tool to check real token usage against its context window, instead of only being interrupted by the automatic token-threshold trigger.",
    "categories": [
      "Sessions & Messages",
      "Tools & Capabilities"
    ],
    "surfaces": [
      "cli",
      "web"
    ],
    "capabilities": {
      "provides": [
        "tool:compact_now",
        "tool:context_status"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "node": ">=22"
    },
    "permissions": {}
  },
  "files": [
    "index.js",
    "select-range.js",
    "context-status.js",
    "safe-point.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  }
}
